            {% endif %}
            {% if environment.isPro() == false %}
            <a href="https://supsystic.com/?mod=user&action=addToCart&pid=23243&addQty=1&goto=checkout&lang=en" target="_blank"><img class="overview-supsystic-img" src="{{ DTGS_PLUGIN_URL }}/src/SupsysticTables/Overview/assets/img/overview-trial.png"></a>
