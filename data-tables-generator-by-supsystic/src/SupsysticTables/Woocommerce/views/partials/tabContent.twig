{% macro checked(option) %}
    {% if option is defined and option == 'on' %}
        checked="checked"
    {% endif %}
{% endmacro %}
{% macro radio_checked(option, value) %}
    {% if option is defined and option == value %}
        checked="checked"
    {% endif %}
{% endmacro %}
{% import _self as checkbox %}
{% import '@ui/tooltip.twig' as tooltip %}
{% set wooAdvancedAllowed = wooAdvancedAllowed|default(false) %}
{% set isWooProductTable = table.table_type|default('default') == 'woo_product_table' %}
{% set wooDesign = table.woo_settings.woocommerce.design|default({}) %}
{% set wooTranslations = table.woo_settings.woocommerce.translations|default({}) %}
{% set excludedProducts = excludedProducts|default([]) %}
{% set wooHiddenClass = 'stHidden' %}
{% if isWooProductTable or table.woo_settings.woocommerce.enable == 'on' %}
    {% set wooHiddenClass = '' %}
{% endif %}
<div class="supRow row-tab" id="row-tab-woocommerce">
<section class="supRow-settings-block">
    <form id="woocommerce-settings" class="supRow woo-settings-form">
        <input type="hidden" name="woocommerce[enable]" value="on" />
        <input type="hidden" name="headerRowsCount" value="{{ table.settings.headerRowsCount|default(1) }}" />
        <input type="hidden" name="tableLoader[iconName]" value="{{ table.settings.tableLoader.iconName|default('default') }}" />
        <input type="hidden" name="tableLoader[iconItems]" value="{{ table.settings.tableLoader.iconItems|default('0') }}" />
        <div class="woo-settings-layout">
            <div class="settings-section woo-settings-sidebar">
                <div class="woo-settings-sidebar-inner">
                    <div class="stb-wraper-anchor-nav-links">
                        <a href="#stb-anl-main" class="stb-anchor-nav-links active">{{ environment.translate('Main') }}</a>
                        <a href="#stb-anl-features" class="stb-anchor-nav-links">{{ environment.translate('Features') }}</a>
                        <a href="#stb-anl-appearance" class="stb-anchor-nav-links">{{ environment.translate('Appearance') }}</a>
                        <a href="#stb-anl-text" class="stb-anchor-nav-links">{{ environment.translate('Catalog') }}</a>
                        <a href="#stb-anl-design" class="stb-anchor-nav-links">{{ environment.translate('Design') }}</a>
                        <a href="#stb-anl-translate" class="stb-anchor-nav-links">{{ environment.translate('Translate') }}</a>
                    </div>
                    <input type="hidden" id="slimScrollStartPos" value="0" />
                    <div class="settings-wrap woo-settings-scroll">
                        <section class="settings-blocks">
                        <section class="supRow-settings-block" id="stb-anl-main">
                            <div class="settings-block-title">
                                <h3><i class="fa fa-fw fa-tachometer"></i> {{ environment.translate('Main Settings') }}</h3>
                            </div>
                            <div class="setting-title">
                                <h3>{{ environment.translate('Table Elements') }}</h3>
                            </div>
                            <div class="setting-wrapper">
                                <div class="setting-label">
                                    <label for="woo-description-text">{{ environment.translate('Description Text') }}</label>
                                </div>
                                <div class="setting-input">
                                    <textarea id="woo-description-text" name="elements[descriptionText]">{{ table.settings.elements.descriptionText|default('') }}</textarea>
                                </div>
                            </div>
                            <div class="setting-wrapper">
                                <div class="setting-label">
                                    <label for="woo-signature-text">{{ environment.translate('Signature Text') }}</label>
                                </div>
                                <div class="setting-input">
                                    <textarea id="woo-signature-text" name="elements[signatureText]">{{ table.settings.elements.signatureText|default('') }}</textarea>
                                </div>
                            </div>
                            <div class="setting-wrapper">
                                <div class="setting-label">
                                    <label for="woo-table-elements-head">
                                        {{ environment.translate('Header') }}
                                        {{ tooltip.icon('<img src="http://supsystic.com/_assets/tables/tooltip/Header.jpg"/>', 'top', true) }}
                                    </label>
                                </div>
                                <div class="setting-check">
                                    <input type="checkbox" name="elements[head]" id="woo-table-elements-head" {{ checkbox.checked(table.settings.elements.head) }} />
                                </div>
                            </div>
                        </section>

                        <section class="supRow-settings-block" id="stb-anl-features">
                            <div class="settings-block-title">
                                <h3><i class="fa fa-fw fa-cogs"></i> {{ environment.translate('Features') }}</h3>
                            </div>
                            <div class="setting-wrapper setting-wrapper-inline">
                                <div class="setting-label">
                                    <label for="woo-features-responsive-mode">
                                        {{ environment.translate('Responsive Mode') }}
                                        {{ tooltip.icon(
                                            environment.translate('Standard Responsive mode - in this mode if table content doesn\'t fit all columns become under each other with one cell per row') ~ '<br><br>' ~
                                            environment.translate('Automatic column hiding - in this mode table columns will collapse from right to left if content does not fit to parent container width') ~ '<br><br>' ~
                                            environment.translate('Horizontal scroll - in this mode scroll bar will be added if table overflows parent container width') ~ '<br><br>' ~
                                            environment.translate('Disable Responsivity - default table fluid layout <a href="https://supsystic.com/example/data-table-responsive-modes/" target="_blank">Read more.</a>')
                                        ) }}
                                    </label>
                                </div>
                                <div class="setting-input">
                                    <select name="responsiveMode" id="woo-features-responsive-mode">
                                        <option value="0" {% if table.settings.responsiveMode|default(0) == '0' or table.settings.responsiveMode|default(0) == 0 %}selected="selected"{% endif %}>{{ environment.translate('Standard Responsive mode') }}</option>
                                        <option value="1" {% if table.settings.responsiveMode|default(1) == '1' or table.settings.responsiveMode|default(1) == 1 %}selected="selected"{% endif %}>{{ environment.translate('Automatic column hiding') }}</option>
                                        <option value="2" {% if table.settings.responsiveMode|default(0) == '2' or table.settings.responsiveMode|default(0) == 2 %}selected="selected"{% endif %}>{{ environment.translate('Horizontal scroll') }}</option>
                                        <option value="3" {% if table.settings.responsiveMode|default(0) == '3' or table.settings.responsiveMode|default(0) == 3 %}selected="selected"{% endif %}>{{ environment.translate('Disable Responsivity') }}</option>
                                    </select>
                                </div>
                            </div>
                            <div class="setting-wrapper">
                                <div class="setting-label">
                                    <label for="woo-features-info">
                                        {{ environment.translate('Table Information') }}
                                        {{ tooltip.icon(environment.translate('Table information display field. %s') | format('<img src="http://supsystic.com/_assets/tables/tooltip/info.jpg"/>') | raw, 'top', true) }}
                                    </label>
                                </div>
                                <div class="setting-check">
                                    <input type="checkbox" name="features[info]" id="woo-features-info" {{ checkbox.checked(table.settings.features.info) }} />
                                </div>
                            </div>
                            <div class="setting-wrapper">
                                <div class="setting-label">
                                    <label for="woo-features-ordering">
                                        {{ environment.translate('Sorting') }}
                                        {{ tooltip.icon('<p style="width:227px; padding:5px margin:0">To allow dynamic sorting with arrows you must enable Header option.</p><p style="width:227px; padding:5px margin:0;color:red">Note that if there are merged cells in the table sorting will be disabled.</p><img src="http://supsystic.com/_assets/tables/tooltip/Ordrering.jpg"/>', 'top', true) }}
                                    </label>
                                </div>
                                <div class="setting-check">
                                    <input type="checkbox" name="features[ordering]" id="woo-features-ordering" {{ checkbox.checked(table.settings.features.ordering) }} />
                                </div>
                            </div>
                            <div class="setting-wrapper woo-sorting-options setting-suboption" {% if table.settings.features.ordering is not defined %}style="display:none"{% endif %}>
                                <div class="setting-label">
                                    <label for="woo-features-sorting-order">
                                        {{ environment.translate('Sorting Order') }}
                                        {{ tooltip.icon(environment.translate('Set sort order by default')) }}
                                    </label>
                                </div>
                                <div class="setting-input">
                                    <select name="sortingOrder" id="woo-features-sorting-order">
                                        <option value="asc" {% if table.settings.sortingOrder|default('asc') == 'asc' %}selected="selected"{% endif %}>{{ environment.translate('Ascending') }}</option>
                                        <option value="desc" {% if table.settings.sortingOrder|default('asc') == 'desc' %}selected="selected"{% endif %}>{{ environment.translate('Descending') }}</option>
                                    </select>
                                </div>
                            </div>
                            <div class="setting-wrapper woo-sorting-options setting-suboption" {% if table.settings.features.ordering is not defined %}style="display:none"{% endif %}>
                                <div class="setting-label">
                                    <label for="woo-sorting-order-column">
                                        {{ environment.translate('Sorting Column') }}
                                        {{ tooltip.icon(environment.translate('Number of column to apply sort order. Set no value to disable table sorting by default.')) }}
                                    </label>
                                </div>
                                <div class="setting-input">
                                    <input name="sortingOrderColumn" id="woo-sorting-order-column" type="text" value="{{ table.settings.sortingOrderColumn|default(1) }}">
                                </div>
                            </div>
                            <div class="setting-wrapper">
                                <div class="setting-label">
                                    <label for="woo-features-pagination">
                                        {{ environment.translate('Pagination') }}
                                        {{ tooltip.icon('<img src="http://supsystic.com/_assets/tables/tooltip/Pagination.jpg"/>', 'top', true) }}
                                    </label>
                                </div>
                                <div class="setting-check">
                                    <input type="checkbox" name="features[paging]" id="woo-features-pagination" {{ checkbox.checked(table.settings.features.paging) }} />
                                </div>
                            </div>
                            <div class="setting-wrapper woo-pagination-options setting-suboption" {% if table.settings.features.paging is not defined %}style="display:none"{% endif %}>
                                <div class="setting-label">
                                    <label for="woo-pagination-length">
                                        {{ environment.translate('Pagination List Content') }}
                                        {{ tooltip.icon('Here you can set the number of rows to display on one Pagination page. Establish several numbers separated by comma to let users choose it personally. First number will be displayed by default. Since that the number of Pagination Pages will be recounted also.', 'top', true) }}
                                    </label>
                                </div>
                                <div class="setting-input">
                                    <input type="text" name="paginationMenuLength" value="{{ table.settings.paginationMenuLength|default('50,100,All') }}" id="woo-pagination-length" />
                                </div>
                            </div>
                            <div class="setting-wrapper woo-pagination-options setting-suboption" {% if table.settings.features.paging is not defined %}style="display:none"{% endif %}>
                                <div class="setting-label">
                                    <label for="woo-pagination-size">{{ environment.translate('Pagination Size') }}</label>
                                </div>
                                <div class="setting-input">
                                    <select name="paginationSize" id="woo-pagination-size">
                                        <option value="pagination-large" {% if table.settings.paginationSize|default('pagination-large') == 'pagination-large' %}selected="selected"{% endif %}>{{ environment.translate('Large') }}</option>
                                        <option value="pagination-medium" {% if table.settings.paginationSize|default('pagination-large') == 'pagination-medium' %}selected="selected"{% endif %}>{{ environment.translate('Medium') }}</option>
                                        <option value="pagination-small" {% if table.settings.paginationSize|default('pagination-large') == 'pagination-small' %}selected="selected"{% endif %}>{{ environment.translate('Small') }}</option>
                                    </select>
                                </div>
                            </div>
                            <div class="setting-wrapper woo-pagination-options setting-suboption" {% if table.settings.features.paging is not defined %}style="display:none"{% endif %}>
                                <div class="setting-label">
                                    <label for="woo-scroll-top-by-pagination">
                                        {{ environment.translate('Scroll top by pagination') }}
                                        {{ tooltip.icon(environment.translate('Scroll to table top for pagination change.')) }}
                                    </label>
                                </div>
                                <div class="setting-check">
                                    <input type="checkbox" name="scrollTopByPagination" id="woo-scroll-top-by-pagination" {{ checkbox.checked(table.settings.scrollTopByPagination) }} />
                                </div>
                            </div>
                            <div class="setting-wrapper woo-pagination-options setting-suboption" {% if table.settings.features.paging is not defined %}style="display:none"{% endif %}>
                                <div class="setting-label">
                                    <label for="woo-server-side-processing">
                                        {{ environment.translate('Server-side Processing') }}
                                        {% if not wooAdvancedAllowed %}
                                            <span class="woo-pro-tag">{{ environment.translate('PRO') }}</span>
                                        {% endif %}
                                        {{ tooltip.icon(environment.translate('This option is recommended for a large tables that cannot be processed in conventional way. The table will be sequentially loaded by ajax on a per page basis, all filtering, ordering and search clauses is server-side implemented too.')) }}
                                    </label>
                                </div>
                                <div class="setting-check">
                                    <input type="checkbox" name="serverSideProcessing" id="woo-server-side-processing" {{ checkbox.checked(table.settings.serverSideProcessing) }} {% if not wooAdvancedAllowed %}disabled="disabled"{% endif %} />
                                </div>
                            </div>
                            <div class="setting-wrapper">
                                <div class="setting-label">
                                    <label for="woo-features-searching">
                                        {{ environment.translate('Searching') }}
                                        {% if not wooAdvancedAllowed %}
                                            <span class="woo-pro-tag">{{ environment.translate('PRO') }}</span>
                                        {% endif %}
                                        {{ tooltip.icon(environment.translate('<b>Search field:</b> enables the main table search input for Woo product tables.<br /><br /><b>Search by Columns:</b> adds separate search inputs for each column. You can use a semicolon to match any of several values.<br /><br /><b>Column Search Position:</b> places those column filters above or below the table.<br /><br /><b>Show Labels:</b> shows the column title near each column search field to make filters easier to understand.<br /><br /><b>Search by Hidden Fields:</b> lets the search include columns hidden on the frontend, including Woo columns marked as hidden.<br /><br /><b>Result Only:</b> hides the table by default and shows it only when the search returns matching products.<br /><br /><b>Show Table:</b> keeps the table visible when Result Only mode is enabled, but leaves it empty until the visitor enters a search query.<br /><br /><b>Strict Matching:</b> matches only values that begin with the typed characters at the start of words.<br /><br /><b>Min Chars:</b> sets the minimum number of typed characters required before search starts. Use 0 to search immediately.'), 'top', true) }}
                                    </label>
                                </div>
                                <div class="setting-check">
                                    <input type="checkbox" name="features[searching]" id="woo-features-searching" {{ checkbox.checked(table.settings.features.searching) }} {% if not wooAdvancedAllowed %}disabled="disabled"{% endif %} />
                                </div>
                            </div>
                            <div class="setting-wrapper woo-searching-options setting-suboption" {% if table.settings.features.searching is not defined %}style="display:none"{% endif %}>
                                <div class="setting-label">
                                    <label for="woo-features-search-by-column">
                                        {{ environment.translate('Search by Columns') }}
                                        {{ tooltip.icon(environment.translate('Add search by table columns. Use a semicolon as separator for select any of the values.')) }}
                                    </label>
                                </div>
                                <div class="setting-check">
                                    <input type="checkbox" name="searching[columnSearch]" id="woo-features-search-by-column" {{ checkbox.checked(table.settings.searching.columnSearch) }} {% if not wooAdvancedAllowed %}disabled="disabled"{% endif %} />
                                </div>
                            </div>
                            <div class="setting-wrapper woo-searching-column-options setting-suboption" {% if table.settings.features.searching is not defined or table.settings.searching.columnSearch is not defined %}style="display:none"{% endif %}>
                                <div class="setting-label">
                                    <label for="woo-features-search-by-column-position">
                                        {{ environment.translate('Location of Search Fields') }}
                                        {{ tooltip.icon(environment.translate('Here you can choose where the column search fields will be: at the top or bottom of the table.')) }}
                                    </label>
                                </div>
                                <div class="setting-input">
                                    <select name="searching[columnSearchPosition]" id="woo-features-search-by-column-position" {% if not wooAdvancedAllowed %}disabled="disabled"{% endif %}>
                                        <option value="bottom" {% if table.settings.searching.columnSearchPosition|default('bottom') == 'bottom' %}selected="selected"{% endif %}>{{ environment.translate('Bottom') }}</option>
                                        <option value="top" {% if table.settings.searching.columnSearchPosition|default('bottom') == 'top' %}selected="selected"{% endif %}>{{ environment.translate('Top') }}</option>
                                    </select>
                                </div>
                            </div>
                            <div class="setting-wrapper woo-searching-column-options setting-suboption" {% if table.settings.features.searching is not defined or table.settings.searching.columnSearch is not defined %}style="display:none"{% endif %}>
                                <div class="setting-label">
                                    <label for="woo-features-search-by-column-labels">
                                        {{ environment.translate('Show Labels') }}
                                        {{ tooltip.icon(environment.translate('Displays the column header text above each column search field to make filters easier to understand.')) }}
                                    </label>
                                </div>
                                <div class="setting-check">
                                    <input type="checkbox" name="searching[columnSearchShowLabel]" id="woo-features-search-by-column-labels" {{ checkbox.checked(table.settings.searching.columnSearchShowLabel) }} {% if not wooAdvancedAllowed %}disabled="disabled"{% endif %} />
                                </div>
                            </div>
                            <div class="setting-wrapper woo-searching-options setting-suboption" {% if table.settings.features.searching is not defined %}style="display:none"{% endif %}>
                                <div class="setting-label">
                                    <label for="woo-search-by-hidden-fields">
                                        {{ environment.translate('Search by Hidden Fields') }}
                                        {% if not wooAdvancedAllowed %}
                                            <span class="woo-pro-tag">{{ environment.translate('PRO') }}</span>
                                        {% endif %}
                                        {{ tooltip.icon(environment.translate('Lets make search by fields, marked as hidden (see appropriate button on editor toolbar)')) }}
                                    </label>
                                </div>
                                <div class="setting-check">
                                    <input type="checkbox" name="searching[searchByHiddenField]" id="woo-search-by-hidden-fields" {{ checkbox.checked(table.settings.searching.searchByHiddenField) }} {% if not wooAdvancedAllowed %}disabled="disabled"{% endif %} />
                                </div>
                            </div>
                            <div class="setting-wrapper woo-searching-options setting-suboption" {% if table.settings.features.searching is not defined %}style="display:none"{% endif %}>
                                <div class="setting-label">
                                    <label for="woo-searching-result-only">
                                        {{ environment.translate('Show Search Results Only') }}
                                        {{ tooltip.icon(environment.translate('Hide table by default and show only if search has a result.')) }}
                                    </label>
                                </div>
                                <div class="setting-check">
                                    <input type="checkbox" name="searching[resultOnly]" id="woo-searching-result-only" {{ checkbox.checked(table.settings.searching.resultOnly) }} {% if not wooAdvancedAllowed %}disabled="disabled"{% endif %} />
                                </div>
                            </div>
                            <div class="setting-wrapper woo-searching-result-options setting-suboption" {% if table.settings.features.searching is not defined or table.settings.searching.resultOnly is not defined %}style="display:none"{% endif %}>
                                <div class="setting-label">
                                    <label for="woo-searching-show-table">
                                        {{ environment.translate('Show Empty Table') }}
                                        {{ tooltip.icon(environment.translate('Table will not be hidden by default , but will be empty.')) }}
                                    </label>
                                </div>
                                <div class="setting-check">
                                    <input type="checkbox" name="searching[showTable]" id="woo-searching-show-table" {{ checkbox.checked(table.settings.searching.showTable) }} {% if not wooAdvancedAllowed %}disabled="disabled"{% endif %} />
                                </div>
                            </div>
                            <div class="setting-wrapper woo-searching-options setting-suboption" {% if table.settings.features.searching is not defined %}style="display:none"{% endif %}>
                                <div class="setting-label">
                                    <label for="woo-searching-strict-matching">
                                        {{ environment.translate('Strict Matching') }}
                                        {{ tooltip.icon(environment.translate('Display only entries with matching characters in the beginning of words')) }}
                                    </label>
                                </div>
                                <div class="setting-check">
                                    <input type="checkbox" name="searching[strictMatching]" id="woo-searching-strict-matching" {{ checkbox.checked(table.settings.searching.strictMatching) }} {% if not wooAdvancedAllowed %}disabled="disabled"{% endif %} />
                                </div>
                            </div>
                            <div class="setting-wrapper woo-searching-options setting-suboption" {% if table.settings.features.searching is not defined %}style="display:none"{% endif %}>
                                <div class="setting-label">
                                    <label for="woo-searching-min-chars">
                                        {{ environment.translate('Minimum Characters') }}
                                        {{ tooltip.icon(environment.translate('Set minimum count of characters to start search in Search field. Set 0 to make search in any case.')) }}
                                    </label>
                                </div>
                                <div class="setting-input">
                                    <input type="text" name="searching[minChars]" id="woo-searching-min-chars" value="{{ table.settings.searching.minChars|default('') }}" {% if not wooAdvancedAllowed %}disabled="disabled"{% endif %} />
                                </div>
                            </div>
                        </section>

                        <section class="supRow-settings-block" id="stb-anl-appearance">
                            <div class="settings-block-title">
                                <h3><i class="fa fa-fw fa-desktop"></i> {{ environment.translate('Appearance') }}</h3>
                            </div>
                            <div class="setting-wrapper">
                                <div class="setting-label">
                                    <label for="woo-features-auto-width">
                                        {{ environment.translate('Auto Table Width') }}
                                        {{ tooltip.icon(environment.translate('If checked - width of table columns will be calculated automatically for table width 100%.<br /><br />Otherwise - you can set table width manually: columns width will be get from Fixed Table Width option (toolbar on Editor tab) or calculated depending on the columns width in the table editor.<br /><br />If you do not want to apply columns width at all - you should uncheck "Auto Table Width" option, set "Fixed Table Width" option to "auto" and check "Compact Table" option.')) }}
                                    </label>
                                </div>
                                <div class="setting-check">
                                    <input type="checkbox" name="features[auto_width]" id="woo-features-auto-width" {{ checkbox.checked(table.settings.features.auto_width) }} />
                                </div>
                            </div>
                            <div class="setting-wrapper woo-width-options setting-suboption" {% if table.settings.features.auto_width is defined %}style="display:none"{% endif %}>
                                <div class="setting-label">
                                    <label for="woo-fixed-table-width">
                                        {{ environment.translate('Fixed Table Width') }}
                                        {{ tooltip.icon(environment.translate('Set fixed table width in px or %. Choose &quot;disable&quot; to make table width adjust by table content.')) }}
                                    </label>
                                </div>
                                <div class="setting-input setting-input-inline">
                                    {% if table.settings.tableWidthType == 'auto' %}
                                        {% set tableWidthTypeDefault = 'auto' %}
                                    {% else %}
                                        {% set tableWidthTypeDefault = '%' %}
                                    {% endif %}
                                    <input type="text" name="tableWidth" value="{{ table.settings.tableWidth|default('100') }}" id="woo-fixed-table-width" class="sub-input woo-table-width-input" {% if table.settings.tableWidthType|default(tableWidthTypeDefault) == 'auto' %}style="display:none"{% endif %} />
                                    <label for="woo-fixed-table-width-type-percent" class="sub-label">
                                        <input type="radio" name="tableWidthType" id="woo-fixed-table-width-type-percent" value="%" {{ checkbox.radio_checked(table.settings.tableWidthType|default(tableWidthTypeDefault), '%') }} />
                                        <span>%</span>
                                    </label>
                                    <label for="woo-fixed-table-width-type-pixels" class="sub-label">
                                        <input type="radio" name="tableWidthType" id="woo-fixed-table-width-type-pixels" value="px" {{ checkbox.radio_checked(table.settings.tableWidthType|default(tableWidthTypeDefault), 'px') }} />
                                        <span>px</span>
                                    </label>
                                    <label for="woo-fixed-table-width-type-auto" class="sub-label">
                                        <input type="radio" name="tableWidthType" id="woo-fixed-table-width-type-auto" value="auto" {{ checkbox.radio_checked(table.settings.tableWidthType|default(tableWidthTypeDefault), 'auto') }} />
                                        <span>{{ environment.translate('disable') }}</span>
                                    </label>
                                </div>
                            </div>
                            <div class="setting-wrapper woo-width-options setting-suboption" {% if table.settings.features.auto_width is defined %}style="display:none"{% endif %}>
                                <div class="setting-label">
                                    <label for="woo-fixed-table-width-mobile">
                                        {{ environment.translate('Fixed Table Width (mobile)') }}
                                        {{ tooltip.icon(environment.translate('Set fixed table width in px or %. Choose &quot;disable&quot; to make table width adjust by table content.')) }}
                                    </label>
                                </div>
                                <div class="setting-input setting-input-inline">
                                    {% if table.settings.tableWidthMobileType == 'auto' %}
                                        {% set tableWidthMobileTypeDefault = 'auto' %}
                                    {% else %}
                                        {% set tableWidthMobileTypeDefault = '%' %}
                                    {% endif %}
                                    <input type="text" name="tableWidthMobile" value="{{ table.settings.tableWidthMobile|default('100') }}" id="woo-fixed-table-width-mobile" class="sub-input woo-table-width-mobile-input" {% if table.settings.tableWidthMobileType|default(tableWidthMobileTypeDefault) == 'auto' %}style="display:none"{% endif %} />
                                    <label for="woo-fixed-table-width-mobile-type-percent" class="sub-label">
                                        <input type="radio" name="tableWidthMobileType" id="woo-fixed-table-width-mobile-type-percent" value="%" {{ checkbox.radio_checked(table.settings.tableWidthMobileType|default(tableWidthMobileTypeDefault), '%') }} />
                                        <span>%</span>
                                    </label>
                                    <label for="woo-fixed-table-width-mobile-type-pixels" class="sub-label">
