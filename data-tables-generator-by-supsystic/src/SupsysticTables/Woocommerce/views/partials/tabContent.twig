                                    <label for="woo-translate-filters">
                                        {{ environment.translate('Filters label') }}
                                        {{ tooltip.icon(environment.translate('Frontend override for the Woo filters label shown above the table.')) }}
                                    </label>
                                </div>
                                <div class="setting-input">
                                    <input type="text" id="woo-translate-filters" name="woocommerce[translations][filters]" value="{{ wooTranslations.filters|default('') }}" placeholder="Filters" />
                                </div>
                            </div>
                            <div class="setting-wrapper">
                                <div class="setting-label">
                                    <label for="woo-translate-reset">
                                        {{ environment.translate('Reset filters button') }}
                                        {{ tooltip.icon(environment.translate('Frontend override for the Woo filters reset button text.')) }}
                                    </label>
                                </div>
                                <div class="setting-input">
                                    <input type="text" id="woo-translate-reset" name="woocommerce[translations][reset]" value="{{ wooTranslations.reset|default('') }}" placeholder="Reset" />
                                </div>
                            </div>
                            <div class="setting-wrapper">
                                <div class="setting-label">
                                    <label for="woo-translate-view-checkout">
                                        {{ environment.translate('View checkout button') }}
