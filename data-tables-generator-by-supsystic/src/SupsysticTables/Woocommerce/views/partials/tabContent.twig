                    </section>
                </div>
            </div>
        </div>
        <div class="woo-settings-panel">
            <div class="woo-catalog-workspace woo-wrapper supLg12 supMd12 supSm12 supXs12{% if wooHiddenClass %} {{ wooHiddenClass }}{% endif %}">
            <div class="supLg12 supMd12 supSm12 supXs12">
                <!-- Save post id's -->
                <input type="hidden" name="woocommerce[productids]" value="{{ table.woo_settings.woocommerce.productids | default('') }}" />

                <!-- Save show elements name like columns order in content table -->
                <input type="hidden" name="woocommerce[order]" value="{{ table.woo_settings.woocommerce.order | default('') }}" />

                <h3 class="stHeaders">{{ environment.translate('Table Columns') }}</h3>
                <label style="padding-bottom: 25px; font-weight: 500;">{{ environment.translate('Select properties to add to the table') }}
                    <select id="chooseColumns">
                        {% set defaultOrder = ['2','4','5','6','11'] %}
                        {% if colNumbOrder is defined and colNumbOrder is not empty %}
                            {% set defaultOrder = colNumbOrder %}
                        {% endif %}
                        {% for col in woocolumns %}
                            <option{% if col.id in defaultOrder %} style="display:none;"{% endif %} value="{{ col.id }}" data-name="{{ col.name }}" data-slug="{{ col.slug }}">
                                {% if col.sub %} &nbsp;-&nbsp; {% endif %} {{ col.name }}
                            </option>
                        {% endfor %}
                    </select>
                </label>

                <button id="stAddButton" class="button active" style="height: 28px; line-height: 26px;"><span>{{ environment.translate('Add') }}</span></button>

                <div class="stPropertiesWrapp">
                    {% set columns = woocolumns %}
                    {% if orders is defined  %}
                        {% set columns = orders %}
                    {% endif %}

                    {% for col in columns %}
                        {% if col.id in defaultOrder %}
                            {% if( orders is defined ) %}
                                {% set dataName = col.original_name|default(col.name)|default('') %}

                                {% set dataNNDisplay = col.show_display_name|default(0) %}

                                {% set dataNN = col.display_name|default('') %}
                                {% set dataMaxWidth = col.max_width|default('') %}
                                {% set dataSlug = col.slug|default('') %}
                                {% set dataHideColumn = col.hide_column|default(0) %}
                                {% set dataHideResponsiveColumn = col.hide_responsive|default(0) %}

                                {% if dataNNDisplay in [1, '1'] and dataNN is not empty %}
                                    {% set contentName = dataNN %}
                                {% else %}
                                    {% set contentName = dataName %}
                                {% endif %}
                            {% else %}
                                {% set dataName = col.name %}
                                {% set dataNNDisplay = '' %}
                                {% set dataNN = '' %}
                                {% set dataMaxWidth = '' %}
                                {% set dataSlug = col.slug %}
                                {% set dataHideColumn = '' %}
                                {% set dataHideResponsiveColumn = '' %}
                                {% set contentName = col.name %}
                            {% endif %}


                            <div class="stOptions"
                                 data-id="{{ col.id }}"
                                 data-name="{{ dataName }}"
                                 data-nice-name-display="{{ dataNNDisplay }}"
                                 data-nice-name="{{ dataNN }}"
                                 data-max-width="{{ dataMaxWidth }}"
                                 data-hide-column="{{ dataHideColumn }}"
                                 data-hide-responsive-column="{{ dataHideResponsiveColumn }}"
                                 data-slug="{{ dataSlug }}"
                            >
                                <div class="content">{{ contentName }}</div>
                                <div class="stOptionHandlers">
                                    <div class="stOptionDragHandler"><i class="fa fa-arrows-h"></i></div>
                                    <div class="stOptionEditHandler"><i class="fa fa-fw fa-pencil"></i></div>
                                    <div class="stOptionRemoveHandler"><i class="fa fa-fw fa-trash-o"></i></div>
                                </div>
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>

                <h3 class="stHeaders">{{ environment.translate('Products') }}</h3>
                <div class="woo-products-pro-panel">
                    <div class="woo-products-pro-panel-header">
                        <span class="woo-products-pro-panel-title">{{ environment.translate('Catalog Rules') }}</span>
                        {% if not wooAdvancedAllowed %}
                            <span class="woo-pro-tag">{{ environment.translate('PRO') }}</span>
                        {% endif %}
                    </div>
                    <div class="woo-products-pro-grid">
                        <div class="woo-products-pro-item" id="stbAutoAddProductsWrapper">
                            <div class="woo-products-pro-item-label">
                                <label for="woocommerce-auto-categories-enable">
                                    {{ environment.translate('Add products automatically') }}
                                    {{ tooltip.icon(environment.translate('Use selected WooCommerce categories as a dynamic catalog source. Matching products will be loaded automatically on the frontend, while excluded product IDs will still be respected. The Table Content list below continues to show only products that were added manually.')) }}
                                </label>
                                {% if not wooAdvancedAllowed %}
                                    <span class="woo-pro-tag">{{ environment.translate('PRO') }}</span>
                                {% endif %}
                            </div>
                            <div class="woo-products-pro-item-controls">
                                <input type="checkbox" name="woocommerce[auto_categories_enable]"
                                    {{ table.woo_settings.woocommerce.auto_categories_enable == 'on' ? 'checked' : '' }}
                                    id="woocommerce-auto-categories-enable"
                                    {% if not wooAdvancedAllowed %}disabled="disabled"{% endif %}
                                />
                                <input type="hidden" name="woocommerce[auto_categories_list]" value="{{ table.woo_settings.woocommerce.auto_categories_list | default() }}" />
                                <select id="stbAutoCategoriesList"
                                    data-placeholder="{{ environment.translate('Select category') }}..."
                                    data-all-selected="{{ environment.translate('All selected') }}"
                                    data-select-all-text="{{ environment.translate('Select all') }}"
                                    {% if not wooAdvancedAllowed %}disabled="disabled"{% endif %}>
                                    {% for name, category in wooCategories %}
                                        <option data-parent="{{ category.parent }}" value="{{ category.value }}">{{ category.title | raw }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                        <div class="woo-products-pro-item woo-products-pro-item-exclude">
                            <div class="woo-products-pro-item-label">
                                <label for="woocommerce-exclude-product-search">
                                    {{ environment.translate('Exclude Product ID(s)') }}
                                    {{ tooltip.icon(environment.translate('Exclude products or individual product variations from the frontend catalog. Search by product title, SKU, or exact product ID. This is especially useful when Show variations is used and you want to hide only one specific variation instead of the whole product family.')) }}
                                </label>
                                {% if not wooAdvancedAllowed %}
                                    <span class="woo-pro-tag">{{ environment.translate('PRO') }}</span>
                                {% endif %}
                            </div>
                            <input type="hidden" name="woocommerce[exclude_productids]" id="woocommerce-exclude-productids" value="{{ table.woo_settings.woocommerce.exclude_productids|default('') }}" />
                            <div class="woo-exclude-search-wrap{% if not wooAdvancedAllowed %} is-disabled{% endif %}">
                                <input type="text" id="woocommerce-exclude-product-search" class="regular-text" placeholder="{{ environment.translate('Search by title, SKU, or product ID') }}" {% if not wooAdvancedAllowed %}disabled="disabled"{% endif %} />
                                <div class="woo-exclude-search-results stHidden"></div>
                            </div>
                            <div class="woo-excluded-products-list{% if excludedProducts is empty %} is-empty{% endif %}" data-empty-text="{{ environment.translate('No excluded products selected yet.') }}">
                                {% for excludedProduct in excludedProducts %}
                                    <div class="woo-excluded-product-card" data-product-id="{{ excludedProduct.id }}"
                                         data-title="{{ excludedProduct.title|e('html_attr') }}"
                                         data-variation="{{ excludedProduct.variation|default('')|e('html_attr') }}"
                                         data-meta="{{ excludedProduct.meta|default('')|e('html_attr') }}"
                                         data-thumbnail="{{ excludedProduct.thumbnail|default('')|e('html_attr') }}">
                                        <div class="woo-excluded-product-body">
                                            <div class="woo-excluded-product-summary">
                                                <span class="woo-excluded-product-title">{{ excludedProduct.title }}</span>
                                                {% if excludedProduct.variation is not empty %}
                                                    <span class="woo-excluded-product-variation">{{ excludedProduct.variation }}</span>
                                                {% endif %}
                                            </div>
                                            {% if excludedProduct.meta is not empty %}
                                                <div class="woo-excluded-product-meta">{{ excludedProduct.meta }}</div>
                                            {% endif %}
                                        </div>
                                        <button type="button" class="button-link-delete woo-excluded-product-remove" aria-label="{{ environment.translate('Remove excluded product') }}">&times;</button>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>

                <button type="button" class="woo-manual-products-toggle is-expanded" aria-expanded="true" aria-controls="woo-manual-products-content">
                    <span class="woo-manual-products-toggle-title">{{ environment.translate('Manual Added Products') }}</span>
                    <span class="woo-manual-products-toggle-icon"><i class="fa fa-chevron-up" aria-hidden="true"></i></span>
                </button>
                <div id="woo-manual-products-content" class="woo-manual-products-content">
                    <table id="stSearchTable" class="stSearchTable">
                        <thead>
                        <tr>
                           <th class="no-sort"><input class="stCheckAll" type="checkbox"/></th>
                           <th>{{ environment.translate('Title') }}</th>
                           <th class="no-sort">{{ environment.translate('Thumbnail') }}</th>
                           <th class="no-sort">{{ environment.translate('Variation') }}</th>
                           <th class="no-sort">{{ environment.translate('Categories') }}</th>
                           <th>{{ environment.translate('Price') }}</th>
                           <th>{{ environment.translate('Date') }}</th>
                        </tr>
                        </thead>
                        <tfoot>
                        <tr>
                           <th class="no-sort"><input class="stCheckAll" type="checkbox"/></th>
                           <th>{{ environment.translate('Title') }}</th>
                           <th class="no-sort">{{ environment.translate('Thumbnail') }}</th>
                           <th class="no-sort">{{ environment.translate('Variation') }}</th>
                           <th class="no-sort">{{ environment.translate('Categories') }}</th>
                           <th>{{ environment.translate('Price') }}</th>
                           <th>{{ environment.translate('Date') }}</th>
                        </tr>
                        </tfoot>
                    </table>

                    <div class="stPropertiesChangeNameWrapp stHidden">
                        <label class="stPropertiesToggleLabel"><input type="checkbox"/>{{ environment.translate('Show text') }} {{ tooltip.icon(environment.translate('Shows the custom column title in the frontend table. This works only when the Header option is enabled for the Woo product table.')) }}</label>
                        <input type="text" class="stColumnTitleInput" />
                        <label class="stPropertiesHideColumnLabel" for="st-column-hide-column">
                            <span class="stPropertiesLabelRow">
                                <span class="stPropertiesLabelText">
                                    {{ environment.translate('Hide column') }}
                                    {{ tooltip.icon(environment.translate('Hide this column on the frontend while optionally keeping it searchable through the global search when Search by Hidden Fields is enabled.')) }}
                                </span>
                                {% if not wooAdvancedAllowed %}
                                    <span class="stPropertiesProTag"><i class="fa fa-lock" aria-hidden="true"></i> {{ environment.translate('PRO') }}</span>
                                {% endif %}
                            </span>
                        </label>
                        <input type="checkbox" id="st-column-hide-column" class="stColumnHideColumnInput" {% if not wooAdvancedAllowed %}disabled="disabled"{% endif %} />
                        <label class="stPropertiesHideColumnLabel stPropertiesHideResponsiveLabel">
                            <span class="stPropertiesLabelRow">
                                <span class="stPropertiesLabelText">
                                    {{ environment.translate('Hide this column (responsive)') }}
                                    {{ tooltip.icon(environment.translate('When Automatic column hiding is enabled, columns with this option checked will be hidden first. If several columns are marked, responsive mode will still collapse them from right to left.')) }}
                                </span>
                                {% if not wooAdvancedAllowed %}
                                    <span class="stPropertiesProTag"><i class="fa fa-lock" aria-hidden="true"></i> {{ environment.translate('PRO') }}</span>
                                {% endif %}
                            </span>
                        </label>
                        <input type="checkbox" class="stColumnHideResponsiveInput" {% if not wooAdvancedAllowed %}disabled="disabled"{% endif %} />
                        <label class="stPropertiesFieldLabel" for="st-column-max-width">
                            <span class="stPropertiesLabelRow">
                                <span class="stPropertiesLabelText">
                                    {{ environment.translate('Max width (px)') }}
                                    {{ tooltip.icon(environment.translate('Limit the maximum visual width of this column on the frontend. Leave empty to let the column size automatically.')) }}
                                </span>
                                {% if not wooAdvancedAllowed %}
                                    <span class="stPropertiesProTag"><i class="fa fa-lock" aria-hidden="true"></i> {{ environment.translate('PRO') }}</span>
                                {% endif %}
                            </span>
                        </label>
                        <input type="number" min="1" step="1" id="st-column-max-width" class="stColumnMaxWidthInput" placeholder="{{ environment.translate('Leave empty for automatic width') }}" {% if not wooAdvancedAllowed %}disabled="disabled"{% endif %} />
                    </div>

                    <div class="stOptions stOptionsEmpty stHidden">
                        <div class="content"></div>
                        <div class="stOptionHandlers">
                            <div class="stOptionDragHandler"><i class="fa fa-arrows-h"></i></div>
                            <div class="stOptionEditHandler"><i class="fa fa-fw fa-pencil"></i></div>
                            <div class="stOptionRemoveHandler"><i class="fa fa-fw fa-trash-o"></i></div>
                        </div>
                    </div>

                    <div class="dt-buttons dt-buttons-add-template stHidden">
                        <button class="dt-button button stAddProducts" tabindex="0" aria-controls="stSearchTable">
                           <span><i class="fa fa-plus"></i>{{ environment.translate('Add selected products to the table') }}</span>
                        </button>
                        <div class="stSearchParams">
                            <input type="checkbox" name="show_variations" value="1"><label>{{ tooltip.icon(environment.translate('Displays all variations as separate items, which can then be added to the table.')) }} show variations</label>
                        </div>
                        <div class="stSearchParams">
                            <input type="checkbox" name="show_private" value="1" {% if not wooAdvancedAllowed %}disabled="disabled"{% endif %}><label>show private{% if not wooAdvancedAllowed %} (PRO){% endif %}</label>
                        </div>
                    </div>
                    <div class="dt-buttons dt-buttons-remove-template stHidden">
                        <button class="dt-button button stRemoveProducts" tabindex="0" aria-controls="stContentTable">
                            <span><i class="fa fa-minus"></i>{{ environment.translate('Remove Selected Products') }}</span>
                        </button>
