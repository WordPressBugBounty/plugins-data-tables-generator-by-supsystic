                                    <label class="woo-design-color-field woo-design-color-field-single"><span>{{ environment.translate('Color') }}</span><input type="color" id="woo-design-border-color" data-design-key="border_color" name="woocommerce[design][border_color]" value="{{ wooDesign.border_color|default('#d7dce1') }}" {% if not wooAdvancedAllowed %}disabled="disabled"{% endif %}></label>
