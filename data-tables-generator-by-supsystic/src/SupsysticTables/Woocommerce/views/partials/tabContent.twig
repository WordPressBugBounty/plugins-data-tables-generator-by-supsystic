                            <div class="setting-wrapper">
                                <div class="setting-label">
                                    <label for="woo-translate-add-selected">
                                        {{ environment.translate('Add selected to cart') }}
                                        {{ tooltip.icon(environment.translate('Frontend override for the multi-add button above the Woo product table.')) }}
                                    </label>
                                </div>
                                <div class="setting-input">
                                    <input type="text" id="woo-translate-add-selected" name="woocommerce[translations][add_selected_to_cart]" value="{{ wooTranslations.add_selected_to_cart|default('') }}" placeholder="Add selected to cart" />
                                </div>
                            </div>
                            <div class="setting-wrapper">
                                <div class="setting-label">
                                    <label for="woo-translate-add-to-cart">
                                        {{ environment.translate('Add to cart button') }}
                                        {{ tooltip.icon(environment.translate('Frontend override for the Add to cart button inside Woo product rows.')) }}
                                    </label>
                                </div>
                                <div class="setting-input">
                                    <input type="text" id="woo-translate-add-to-cart" name="woocommerce[translations][add_to_cart]" value="{{ wooTranslations.add_to_cart|default('') }}" placeholder="Add to cart" />
                                </div>
