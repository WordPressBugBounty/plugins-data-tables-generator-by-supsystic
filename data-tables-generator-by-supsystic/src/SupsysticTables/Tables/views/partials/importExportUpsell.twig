{% set url = build_pro_url({ 'utm_medium': 'import_export' }) %}
<div id="import_exportProFeatureDialog" style="display: none;">
    <div class="stb-upsell">
        <div class="stb-upsell-hero">
            <span class="stb-upsell-eyebrow"><i class="fa fa-diamond" aria-hidden="true"></i>{{ environment.translate('PRO feature') }}</span>
            <div class="stb-upsell-head">
                <div>
                    <h2>{{ environment.translate('Bring your data in. Send it out anywhere.') }}</h2>
                    <p>{{ environment.translate('Stop retyping tables by hand. Load a spreadsheet in seconds and give people the file they need in one click.') }}</p>
                </div>
                <a class="stb-upsell-cta" href="{{ url }}" target="_blank" rel="noopener">{{ environment.translate('Get PRO') }}<i class="fa fa-arrow-right" aria-hidden="true"></i></a>
            </div>
            <div class="stb-upsell-flow" aria-hidden="true">
                <div class="stb-upsell-files">
                    <span><i class="fa fa-file-text-o"></i>CSV</span>
                    <span><i class="fa fa-file-excel-o"></i>Excel</span>
                    <span><i class="fa fa-file-code-o"></i>JSON</span>
                    <span><i class="fa fa-google"></i>Google Sheets</span>
                </div>
                <i class="fa fa-long-arrow-right stb-upsell-arrow"></i>
                <div class="stb-upsell-table"><i class="fa fa-table"></i>{{ environment.translate('Your table') }}</div>
                <i class="fa fa-long-arrow-right stb-upsell-arrow"></i>
                <div class="stb-upsell-files">
                    <span><i class="fa fa-file-text-o"></i>CSV</span>
                    <span><i class="fa fa-file-pdf-o"></i>PDF</span>
                    <span><i class="fa fa-file-excel-o"></i>Excel</span>
                    <span><i class="fa fa-file-code-o"></i>JSON</span>
                </div>
            </div>
        </div>
        <div class="stb-upsell-cards">
            <div class="stb-upsell-card">
                <div class="stb-upsell-card-head">
                    <span class="stb-upsell-card-icon"><i class="fa fa-download" aria-hidden="true"></i></span>
                    <h3>{{ environment.translate('Import') }}</h3>
                </div>
                <ul>
                    <li>{{ environment.translate('Upload CSV, Excel or JSON files') }}</li>
                    <li>{{ environment.translate('Pull a Google Sheet by its link') }}</li>
                    <li>{{ environment.translate('Keep the source formatting or take raw data only') }}</li>
                    <li>{{ environment.translate('Keep a table in sync with Google Sheets or an FTP file') }}</li>
                </ul>
            </div>
            <div class="stb-upsell-card">
                <div class="stb-upsell-card-head">
                    <span class="stb-upsell-card-icon"><i class="fa fa-upload" aria-hidden="true"></i></span>
                    <h3>{{ environment.translate('Export') }}</h3>
                </div>
                <ul>
                    <li>{{ environment.translate('Save as CSV, PDF, JSON, XLS or XLSX') }}</li>
                    <li>{{ environment.translate('PDF with your paper size, orientation and logo') }}</li>
                    <li>{{ environment.translate('Export, print and email buttons for visitors on the page') }}</li>
                    <li>{{ environment.translate('Export only the rows left after filtering') }}</li>
                </ul>
            </div>
        </div>
        <p class="stb-upsell-note">{{ environment.translate('PRO also adds charts, database sources, table history and more.') }}</p>
    </div>
</div>
